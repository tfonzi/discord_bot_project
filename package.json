{
  "name": "discord-bot-project",
  "version": "2.0.0",
  "description": "Discord bot using OpenAI API and Redis for embeddings",
  "main": "dist/src/index.js",
  "scripts": {
    "typecheck": "tsc",
    "build": "rm -rf dist && swc src --out-dir dist",
    "start": "node dist/src/index.js",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:up-logs": "docker compose up -d && docker compose logs -f",
    "docker:rebuild": "docker compose up -d --build",
    "docker:rebuild-logs": "docker compose up -d --build && docker compose logs -f"
  },
  "dependencies": {
    "async-mutex": "^0.4.0",
    "async-retry": "^1.3.3",
    "discord.js": "^14.18.0",
    "dotenv": "^16.3.1",
    "emoji-dictionary": "^1.0.12",
    "gpt-3-encoder": "^1.1.4",
    "openai": "^4.95.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "redis": "^4.6.13",
    "serialize-error": "^12.0.0"
  },
  "devDependencies": {
    "@swc/cli": "^0.7.2",
    "@swc/core": "^1.11.21",
    "@swc/plugin-transform-imports": "^7.0.3",
    "@types/node": "^20.10.5",
    "typescript": "^5.3.3"
  },
  "type": "module"
}
